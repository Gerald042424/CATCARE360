FROM composer:2 AS composer

FROM php:8.2-cli AS dependencies

WORKDIR /app

COPY --from=composer /usr/bin/composer /usr/bin/composer
RUN apt-get update \
    && apt-get install -y --no-install-recommends libicu-dev unzip \
    && docker-php-ext-install intl \
    && rm -rf /var/lib/apt/lists/*

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader

COPY . ./
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative


FROM php:8.2-apache

ENV CI_ENVIRONMENT=production \
    APP_RUNTIME=vercel

RUN apt-get update \
    && apt-get install -y --no-install-recommends libicu-dev \
    && docker-php-ext-install intl mysqli pdo_mysql \
    && rm -rf /var/lib/apt/lists/* \
    && a2enmod rewrite \
    && sed -ri 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/*.conf

WORKDIR /var/www/html
COPY --from=dependencies --chown=www-data:www-data /app ./
COPY docker/vercel-entrypoint.sh /usr/local/bin/vercel-entrypoint

# Vercel's deployed image filesystem is read-only. Keep CI's transient files
# and uploaded defense-demo files in its writable per-instance /tmp area.
RUN rm -rf /var/www/html/writable /var/www/html/public/uploads \
    && ln -s /tmp/catcare-writable /var/www/html/writable \
    && ln -s /tmp/catcare-uploads /var/www/html/public/uploads \
    && chmod +x /usr/local/bin/vercel-entrypoint

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/vercel-entrypoint"]
